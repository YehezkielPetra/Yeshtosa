<%- include('layouts/header') %>
<div class="max-w-xl mx-auto bg-white dark:bg-gray-800 rounded-2xl p-8 border dark:border-gray-700 shadow-sm">
    <div class="text-center mb-6">
        <div class="w-20 h-20 bg-amber-100 dark:bg-amber-900/30 text-amber-600 rounded-full flex items-center justify-center text-3xl font-serif font-bold mx-auto mb-3">
            <%= username.charAt(0).toUpperCase() %>
        </div>
        <h3 class="text-xl font-bold text-gray-900 dark:text-white"><%= username %></h3>
        <p class="text-xs text-gray-400 mt-0.5">Administrator Utama Toko</p>
    </div>

    <form action="/profile/update" method="POST" class="space-y-4">
        <div>
            <label class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">Ganti Alamat Email Aktif</label>
            <input type="email" name="email" value="<%= user.email %>" required class="w-full p-3 bg-gray-50 dark:bg-gray-700 rounded-xl border dark:border-gray-600 text-gray-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-amber-500 text-sm">
        </div>
        
        <div>
            <label class="block text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1">Ubah Kata Sandi / Password Baru</label>
            <input type="password" name="password" placeholder="Kosongkan jika tidak ingin mengubah password lama..." class="w-full p-3 bg-gray-50 dark:bg-gray-700 rounded-xl border dark:border-gray-600 text-gray-900 dark:text-white focus:outline-none focus:ring-1 focus:ring-amber-500 text-sm">
        </div>

        <div class="p-5 bg-amber-50/40 dark:bg-amber-950/10 rounded-xl border border-amber-100 dark:border-amber-900/40 space-y-4">
            <label class="block text-xs font-bold text-amber-700 dark:text-amber-400 uppercase tracking-wide">Konfigurasi Standar Jual Kue (Per Pcs)</label>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                <div>
                    <label class="block text-[11px] text-gray-500 font-medium mb-1">Ukuran Kecil</label>
                    <div class="relative">
                        <span class="absolute left-2 top-2.5 text-xs font-bold text-amber-600">Rp</span>
                        <input type="number" name="harga_kecil" value="<%= user.harga_kecil || 0 %>" required class="w-full p-2 pl-7 bg-white dark:bg-gray-700 rounded-lg border text-xs font-bold text-gray-900 dark:text-white">
                    </div>
                </div>
                <div>
                    <label class="block text-[11px] text-gray-500 font-medium mb-1">Ukuran Besar</label>
                    <div class="relative">
                        <span class="absolute left-2 top-2.5 text-xs font-bold text-amber-600">Rp</span>
                        <input type="number" name="harga_besar" value="<%= user.harga_besar || 0 %>" required class="w-full p-2 pl-7 bg-white dark:bg-gray-700 rounded-lg border text-xs font-bold text-gray-900 dark:text-white">
                    </div>
                </div>
                <div>
                    <label class="block text-[11px] text-gray-500 font-medium mb-1">Ukuran Jumbo</label>
                    <div class="relative">
                        <span class="absolute left-2 top-2.5 text-xs font-bold text-amber-600">Rp</span>
                        <input type="number" name="harga_jumbo" value="<%= user.harga_jumbo || 0 %>" required class="w-full p-2 pl-7 bg-white dark:bg-gray-700 rounded-lg border text-xs font-bold text-gray-900 dark:text-white">
                    </div>
                </div>
            </div>
        </div>

        <button type="submit" class="w-full py-2.5 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl transition text-sm shadow-sm">Simpan Perubahan Akun</button>
    </form>
    
    <div class="border-t dark:border-gray-700 my-4 pt-4">
        <a href="/logout" class="block w-full py-2.5 bg-red-500 hover:bg-red-600 text-white text-center rounded-xl font-semibold text-sm transition shadow-sm">Keluar dari Sesi (Logout)</a>
    </div>
</div>
<%- include('layouts/footer') %>