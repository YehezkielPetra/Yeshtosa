<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Toko Kue - Register Admin</title>
    <link href="/css/output.css" rel="stylesheet">
    <script src="/js/theme.js"></script>
</head>
<body class="bg-kue-light dark:bg-gray-900 min-h-screen flex flex-col justify-center items-center font-sans p-4">
    
    <%- include('layouts/popup') %>

    <div class="bg-white dark:bg-gray-800 border border-amber-100 dark:border-gray-700 w-full max-w-md rounded-2xl p-8 shadow-sm">
        <h2 class="text-xl font-serif font-bold text-gray-900 dark:text-white mb-6">Daftar Akun Baru</h2>
        
        <form action="/register" method="POST" class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-1">Username</label>
                <input type="text" name="username" required class="w-full px-4 py-3 bg-kue-input dark:bg-gray-700 border-none rounded-xl text-gray-800 dark:text-white text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-1">Email</label>
                <input type="email" name="email" required class="w-full px-4 py-3 bg-kue-input dark:bg-gray-700 border-none rounded-xl text-gray-800 dark:text-white text-sm">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-1">Password Secure</label>
                <input type="password" name="password" required class="w-full px-4 py-3 bg-kue-input dark:bg-gray-700 border-none rounded-xl text-gray-800 dark:text-white text-sm">
            </div>
            <button type="submit" class="w-full py-3 bg-kue-brand hover:bg-kue-brandHover text-white font-medium rounded-xl text-sm">Daftar</button>
        </form>
        <p class="text-center text-xs text-gray-600 dark:text-gray-400 mt-6">
            Sudah ada akun? <a href="/login" class="text-kue-brand font-medium hover:underline">Masuk disini</a>
        </p>
    </div>
</body>
</html>