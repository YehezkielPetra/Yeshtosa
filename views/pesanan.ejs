<%- include('layouts/header') %>
<div class="max-w-4xl mx-auto bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-sm border dark:border-gray-700">
    <div class="flex items-center space-x-2 mb-6 border-b dark:border-gray-700 pb-3">
        <span class="text-xl">📥</span>
        <h3 class="text-xl font-bold font-serif text-gray-800 dark:text-white">Input Pesanan Masuk</h3>
    </div>

    <form action="/pesanan" method="POST" class="space-y-6">
        <div>
            <label class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-1">Nama Pemesan / Pelanggan</label>
            <input type="text" name="nama_pemesan" required placeholder="Contoh: Ibu Lina" class="w-full p-3 bg-gray-50 dark:bg-gray-700 rounded-xl border border-gray-200 dark:border-gray-600 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-amber-500">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-2">Rencana Tanggal Kirim</label>
                <div class="flex space-x-2 mb-2">
                    <button type="button" onclick="setKirimHariIni()" id="btnKirimHariIni" class="flex-1 py-1.5 rounded-lg text-xs font-semibold border transition">Hari Ini</button>
                    <button type="button" onclick="setKirimNanti()" id="btnKirimNanti" class="flex-1 py-1.5 rounded-lg text-xs font-semibold border transition">Nanti</button>
                </div>
                <input type="date" id="tanggal_kirim" name="tanggal_kirim" required class="w-full p-3 bg-gray-50 dark:bg-gray-700 rounded-xl border text-gray-900 dark:text-white focus:outline-none">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-2">Jam Kirim Kue Pemesan</label>
                <input type="time" name="jam_kirim" required class="w-full p-3 mt-10 bg-gray-50 dark:bg-gray-700 rounded-xl border text-gray-900 dark:text-white focus:outline-none">
            </div>
        </div>

        <hr class="dark:border-gray-700">

        <div class="hidden md:grid grid-cols-12 gap-4 px-4 text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wider">
            <div class="col-span-4">Jumlah Order (Pcs)</div>
            <div class="col-span-4">Rasa</div>
            <div class="col-span-4">Ukuran</div>
        </div>

        <div id="wrapper-item-kue" class="space-y-4">
            <div class="item-kue-row p-4 bg-amber-50/20 dark:bg-gray-900/40 rounded-xl border border-dashed border-amber-200 dark:border-gray-700 relative">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        <label class="block md:hidden text-xs font-semibold text-gray-500 mb-1">Jumlah Order (Pcs)</label>
                        <input type="number" name="jumlah_kue" required class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border text-sm text-gray-900 dark:text-white">
                    </div>
                    <div>
                        <label class="block md:hidden text-xs font-semibold text-gray-500 mb-1">Rasa</label>
                        <select name="rasa" class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border text-sm text-gray-900 dark:text-white">
                            <option value="tidak pedas">Tidak Pedas</option>
                            <option value="pedas">Pedas</option>
                        </select>
                    </div>
                    <div>
                        <label class="block md:hidden text-xs font-semibold text-gray-500 mb-1">Ukuran</label>
                        <select name="ukuran" class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border text-sm text-gray-900 dark:text-white">
                            <option value="kecil">Kecil</option>
                            <option value="besar">Besar</option>
                            <option value="jumbo">Jumbo</option>
                        </select>
                    </div>
                </div>
                <div class="flex items-center justify-between mt-3 pt-2 border-t border-gray-100 dark:border-gray-700/50">
                    <label class="flex items-center space-x-2">
                        <input type="hidden" name="is_frozen" value="0" id="frozen_hidden_0">
                        <input type="checkbox" onchange="handleFrozenCheckbox(this, 0)" class="w-4 h-4 text-amber-500 rounded focus:ring-amber-500 dark:bg-gray-700 dark:border-gray-600">
                        <span class="text-xs text-gray-600 dark:text-gray-400">Frozen State</span>
                    </label>
                    <button type="button" onclick="hapusBarisItem(this)" class="text-xs text-red-500 font-semibold hover:underline hidden btn-hapus-row">Hapus Item</button>
                </div>
            </div>
        </div>

        <button type="button" onclick="tambahBarisItem()" class="w-full py-2.5 bg-gray-50 dark:bg-gray-700/50 hover:bg-gray-100 text-gray-700 text-xs font-bold rounded-xl border border-dashed border-gray-300 dark:border-gray-600">+ Tambah Rincian Item</button>
        <button type="submit" class="w-full py-3 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-sm transition">Simpan Semua Invoice Pesanan</button>
    </form>
</div>

<script>
    let rowIndex = 1;
    function tambahBarisItem() {
        const wrapper = document.getElementById('wrapper-item-kue');
        const newRow = document.createElement('div');
        newRow.className = "item-kue-row p-4 bg-amber-50/20 dark:bg-gray-900/40 rounded-xl border border-dashed border-amber-200 dark:border-gray-700 relative";
        newRow.innerHTML = `
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <div><input type="number" name="jumlah_kue" required class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border text-sm text-gray-900 dark:text-white"></div>
                <div><select name="rasa" class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border text-sm text-gray-900 dark:text-white"><option value="tidak pedas">Tidak Pedas</option><option value="pedas">Pedas</option></select></div>
                <div><select name="ukuran" class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border text-sm text-gray-900 dark:text-white"><option value="kecil">Kecil</option><option value="besar">Besar</option><option value="jumbo">Jumbo</option></select></div>
            </div>
            <div class="flex items-center justify-between mt-3 pt-2 border-t border-gray-100 dark:border-gray-700/50">
                <label class="flex items-center space-x-2"><input type="hidden" name="is_frozen" value="0" id="frozen_hidden_${rowIndex}"><input type="checkbox" onchange="handleFrozenCheckbox(this, ${rowIndex})" class="w-4 h-4 text-amber-500 rounded"><span class="text-xs text-gray-600 dark:text-gray-400">Frozen State</span></label>
                <button type="button" onclick="hapusBarisItem(this)" class="text-xs text-red-500 font-semibold hover:underline btn-hapus-row">Hapus Item</button>
            </div>`;
        wrapper.appendChild(newRow); rowIndex++; toggleHapusButtonVisibility();
    }
    function hapusBarisItem(b) { b.closest('.item-kue-row').remove(); toggleHapusButtonVisibility(); }
    function toggleHapusButtonVisibility() {
        const rows = document.querySelectorAll('.item-kue-row');
        rows.forEach(r => { const btn = r.querySelector('.btn-hapus-row'); if (btn) { if (rows.length === 1) btn.classList.add('hidden'); else btn.classList.remove('hidden'); } });
    }
    function handleFrozenCheckbox(c, i) { document.getElementById(`frozen_hidden_${i}`).value = c.checked ? "1" : "0"; }
    
    const inputTgl = document.getElementById('tanggal_kirim');
    const bHariIni = document.getElementById('btnKirimHariIni');
    const bNanti = document.getElementById('btnKirimNanti');
    function setKirimHariIni() { if(inputTgl) { inputTgl.value = new Date().toLocaleDateString('fr-CA'); inputTgl.readOnly = true; bHariIni.className = "flex-1 py-1.5 rounded-lg text-xs font-semibold bg-amber-500 text-white border-amber-500"; bNanti.className = "flex-1 py-1.5 rounded-lg text-xs font-semibold bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300 border-transparent"; } }
    function setKirimNanti() { if(inputTgl) { inputTgl.value = ""; inputTgl.readOnly = false; bHariIni.className = "flex-1 py-1.5 rounded-lg text-xs font-semibold bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300 border-transparent"; bNanti.className = "flex-1 py-1.5 rounded-lg text-xs font-semibold bg-amber-500 text-white border-amber-500"; } }
    document.addEventListener('DOMContentLoaded', () => setKirimHariIni());
</script>
<%- include('layouts/footer') %>