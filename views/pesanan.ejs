<%- include('layouts/header') %>
<div class="max-w-4xl mx-auto bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-sm border dark:border-gray-700">
    <div class="flex items-center space-x-2 mb-6 border-b dark:border-gray-700 pb-3">
        <span class="text-xl">📥</span>
        <h3 class="text-xl font-bold font-serif text-gray-800 dark:text-white">Input Pesanan Masuk</h3>
    </div>

    <form action="/pesanan" method="POST" class="space-y-6">
        <div>
            <label class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-1">Nama Pemesan / Pelanggan</label>
            <input type="text" name="nama_pemesan" required placeholder="Contoh: Ibu Lina" class="w-full p-3 bg-gray-50 dark:bg-gray-700 rounded-xl border border-gray-200 dark:border-gray-600 text-gray-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-amber-500">
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-2">Rencana Tanggal Kirim</label>
                <div class="flex space-x-2 mb-2">
                    <button type="button" onclick="setKirimHariIni()" id="btnKirimHariIni" class="flex-1 py-1.5 rounded-lg text-xs font-semibold border transition">Hari Ini</button>
                    <button type="button" onclick="setKirimNanti()" id="btnKirimNanti" class="flex-1 py-1.5 rounded-lg text-xs font-semibold border transition">Nanti</button>
                </div>
                <input type="date" id="tanggal_kirim" name="tanggal_kirim" required class="w-full p-3 bg-gray-50 dark:bg-gray-700 rounded-xl border text-gray-900 dark:text-white focus:outline-none">
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-2">Jam Kirim Kue Pemesan</label>
                <input type="time" name="jam_kirim" required class="w-full p-3 mt-10 bg-gray-50 dark:bg-gray-700 rounded-xl border text-gray-900 dark:text-white focus:outline-none">
            </div>
        </div>

        <hr class="dark:border-gray-700">

        <div id="wrapper-item-kue" class="space-y-4">
            <div class="item-kue-row p-4 bg-amber-50/20 dark:bg-gray-900/40 rounded-xl border border-dashed border-amber-200 dark:border-gray-700 relative">
                <div class="grid grid-cols-1 md:grid-cols-5 gap-3 items-end">
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Jumlah (Pcs)</label>
                        <input type="number" name="jumlah_kue" required class="w-full p-2 bg-white dark:bg-gray-700 rounded-lg border text-sm text-gray-900 dark:text-white focus:outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Rasa</label>
                        <select name="rasa" class="w-full p-2 bg-white dark:bg-gray-700 rounded-lg border text-sm text-gray-900 dark:text-white focus:outline-none">
                            <option value="tidak pedas">Tidak Pedas</option>
                            <option value="pedas">Pedas</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Ukuran</label>
                        <select name="ukuran" class="w-full p-2 bg-white dark:bg-gray-700 rounded-lg border text-sm text-gray-900 dark:text-white focus:outline-none">
                            <option value="kecil">Kecil</option>
                            <option value="besar">Besar</option>
                            <option value="jumbo">Jumbo</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Kategori Tipe</label>
                        <select name="tipe_pesanan" onchange="toggleHargaKustom(this, 0)" class="w-full p-2 bg-white dark:bg-gray-700 rounded-lg border text-sm text-gray-900 dark:text-white focus:outline-none font-bold">
                            <option value="Reguler">📦 Reguler</option>
                            <option value="Spesial">✨ Spesial (Custom)</option>
                        </select>
                    </div>
                    <div id="container-harga-kustom-0" class="hidden">
                        <label class="block text-xs font-bold text-amber-600 mb-1">Harga Kustom (Rp)</label>
                        <input type="number" name="harga_kustom" value="0" class="w-full p-2 bg-amber-50/50 dark:bg-gray-800 rounded-lg border border-amber-300 text-sm font-bold text-gray-900 dark:text-white focus:outline-none">
                    </div>
                </div>
                <div class="flex items-center justify-between mt-3 pt-2 border-t border-gray-100 dark:border-gray-700/50">
                    <label class="flex items-center space-x-2">
                        <input type="hidden" name="is_frozen" value="0" id="frozen_hidden_0">
                        <input type="checkbox" onchange="handleFrozenCheckbox(this, 0)" class="w-4 h-4 text-amber-500 rounded">
                        <span class="text-xs text-gray-600 dark:text-gray-400">Frozen State</span>
                    </label>
                    <button type="button" onclick="hapusBarisItem(this)" class="text-xs text-red-500 font-semibold hover:underline hidden btn-hapus-row">Hapus</button>
                </div>
            </div>
        </div>

        <button type="button" onclick="tambahBarisItem()" class="w-full py-2.5 bg-gray-50 dark:bg-gray-700/50 hover:bg-gray-100 text-gray-700 text-xs font-bold rounded-xl border border-dashed border-gray-300 dark:border-gray-600">+ Tambah Rincian Item</button>
        <button type="submit" class="w-full py-3 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-sm transition">Simpan Semua Invoice Pesanan</button>
    </form>
</div>

<script>
    let rowIndex = 1;

    function toggleHargaKustom(selectEl, idx) {
        const container = document.getElementById(`container-harga-kustom-${idx}`);
        const inputHarga = container ? container.querySelector('input[name="harga_kustom"]') : null;
        if (selectEl.value === 'Spesial') {
            container.classList.remove('hidden');
        } else {
            container.classList.add('hidden');
            if(inputHarga) inputHarga.value = "0";
        }
    }

    function tambahBarisItem() {
        const wrapper = document.getElementById('wrapper-item-kue');
        const newRow = document.createElement('div');
        newRow.className = "item-kue-row p-4 bg-amber-50/20 dark:bg-gray-900/40 rounded-xl border border-dashed border-amber-200 dark:border-gray-700 relative";
        newRow.innerHTML = `
            <div class="grid grid-cols-1 md:grid-cols-5 gap-3 items-end">
                <div><input type="number" name="jumlah_kue" required class="w-full p-2 bg-white dark:bg-gray-700 rounded-lg border text-sm text-gray-900 dark:text-white focus:outline-none"></div>
                <div><select name="rasa" class="w-full p-2 bg-white dark:bg-gray-700 rounded-lg border text-sm text-gray-900 dark:text-white focus:outline-none"><option value="tidak pedas">Tidak Pedas</option><option value="pedas">Pedas</option></select></div>
                <div><select name="ukuran" class="w-full p-2 bg-white dark:bg-gray-700 rounded-lg border text-sm text-gray-900 dark:text-white focus:outline-none"><option value="kecil">Kecil</option><option value="besar">Besar</option><option value="jumbo">Jumbo</option></select></div>
                <div>
                    <select name="tipe_pesanan" onchange="toggleHargaKustom(this, ${rowIndex})" class="w-full p-2 bg-white dark:bg-gray-700 rounded-lg border text-sm text-gray-900 dark:text-white focus:outline-none font-bold">
                        <option value="Reguler">📦 Reguler</option>
                        <option value="Spesial">✨ Spesial (Custom)</option>
                    </select>
                </div>
                <div id="container-harga-kustom-${rowIndex}" class="hidden">
                    <input type="number" name="harga_kustom" value="0" class="w-full p-2 bg-amber-50/50 dark:bg-gray-800 rounded-lg border border-amber-300 text-sm font-bold text-gray-900 dark:text-white focus:outline-none">
                </div>
            </div>
            <div class="flex items-center justify-between mt-3 pt-2 border-t border-gray-100 dark:border-gray-700/50">
                <label class="flex items-center space-x-2"><input type="hidden" name="is_frozen" value="0" id="frozen_hidden_${rowIndex}"><input type="checkbox" onchange="handleFrozenCheckbox(this, ${rowIndex})" class="w-4 h-4 text-amber-500 rounded"><span class="text-xs text-gray-600 dark:text-gray-400">Frozen State</span></label>
                <button type="button" onclick="hapusBarisItem(this)" class="text-xs text-red-500 font-semibold hover:underline btn-hapus-row">Hapus</button>
            </div>`;
        wrapper.appendChild(newRow); rowIndex++; toggleHapusButtonVisibility();
    }
    
    function hapusBarisItem(b) { b.closest('.item-kue-row').remove(); toggleHapusButtonVisibility(); }
    function toggleHapusButtonVisibility() {
        const rows = document.querySelectorAll('.item-kue-row');
        rows.forEach(r => { const btn = r.querySelector('.btn-hapus-row'); if (btn) { if (rows.length === 1) btn.classList.add('hidden'); else btn.classList.remove('hidden'); } });
    }
    function handleFrozenCheckbox(c, i) { document.getElementById(`frozen_hidden_${i}`).value = c.checked ? "1" : "0"; }
    
    const inputTgl = document.getElementById('tanggal_kirim');
    const bHariIni = document.getElementById('btnKirimHariIni');
    const bNanti = document.getElementById('btnKirimNanti');
    function setKirimHariIni() { if(inputTgl) { inputTgl.value = new Date().toLocaleDateString('fr-CA'); inputTgl.readOnly = true; bHariIni.className = "flex-1 py-1.5 rounded-lg text-xs font-semibold bg-amber-500 text-white"; bNanti.className = "flex-1 py-1.5 rounded-lg text-xs font-semibold bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300"; } }
    function setKirimNanti() { if(inputTgl) { inputTgl.value = ""; inputTgl.readOnly = false; bHariIni.className = "flex-1 py-1.5 rounded-lg text-xs font-semibold bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300"; bNanti.className = "flex-1 py-1.5 rounded-lg text-xs font-semibold bg-amber-500 text-white"; } }
    document.addEventListener('DOMContentLoaded', () => setKirimHariIni());
</script>
<%- include('layouts/footer') %>