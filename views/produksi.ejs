<%- include('layouts/header') %>
<div class="max-w-4xl mx-auto bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-sm border dark:border-gray-700">
    <div class="flex items-center space-x-2 mb-6">
        <span class="text-xl">🍳</span>
        <h3 class="text-xl font-bold font-serif">Input Kebutuhan Produksi Masak</h3>
    </div>
    
    <form action="/produksi" method="POST" class="space-y-6">
        <div>
            <label class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-1">Tanggal Jadwal Masak</label>
            <input type="date" name="tanggal_produksi" required class="w-full p-3 bg-gray-50 dark:bg-gray-700 rounded-xl border border-gray-200 dark:border-gray-600">
        </div>

        <hr class="dark:border-gray-700">
        <div id="wrapper-produksi" class="space-y-4">
            <div class="produksi-row p-4 bg-amber-50/40 dark:bg-gray-900/40 rounded-xl border border-dashed border-amber-200 dark:border-gray-700">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Masak Berapa?</label>
                        <input type="number" step="0.01" name="jumlah_kg" required class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Jumlah Gogos Jadi (Pcs)</label>
                        <input type="number" name="jumlah_kue" required class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border text-sm">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Rasa</label>
                        <select name="rasa" class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border text-sm">
                            <option value="tidak pedas">Tidak Pedas</option>
                            <option value="pedas">Pedas</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-gray-500 mb-1">Ukuran Kue</label>
                        <select name="ukuran" class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border text-sm">
                            <option value="kecil">Kecil</option>
                            <option value="besar">Besar</option>
                            <option value="jumbo">Jumbo</option>
                        </select>
                    </div>
                </div>
                <div class="text-right mt-2">
                    <button type="button" onclick="hapusBarisProduksi(this)" class="text-xs text-red-500 font-semibold hover:underline hidden btn-hapus-prod">Hapus Baris</button>
                </div>
            </div>
        </div>

        <button type="button" onclick="tambahBarisProduksi()" class="w-full py-2 bg-gray-100 dark:bg-gray-700 hover:bg-gray-200 text-gray-700 dark:text-gray-200 text-xs font-bold rounded-xl transition border border-dashed border-gray-300 dark:border-gray-600">
            + Tambah
        </button>

        <button type="submit" class="w-full py-3 bg-kue-brand hover:bg-kue-brandHover text-white font-bold rounded-xl shadow-sm transition">Simpan Semua Rencana Rilis Produksi</button>
    </form>

    <div class="mt-10 pt-6 border-t border-gray-100 dark:border-gray-700">
        <div class="flex items-center space-x-2 mb-4">
            <span>📋</span>
            <h4 class="text-base font-bold font-serif text-gray-800 dark:text-gray-200">Log Produksi Masak Hari Ini</h4>
        </div>
        
        <% if (produksiHariIni && produksiHariIni.length > 0) { %>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs border-collapse">
                    <thead>
                        <tr class="bg-gray-50 dark:bg-gray-900 text-gray-500 dark:text-gray-400 font-semibold uppercase tracking-wider border-b dark:border-gray-700">
                            <th class="p-3">Porsi Masak</th>
                            <th class="p-3">Hasil Jadi</th>
                            <th class="p-3">Varian Rasa</th>
                            <th class="p-3">Ukuran</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700 text-gray-700 dark:text-gray-300">
                        <% produksiHariIni.forEach(item => { %>
                            <tr class="hover:bg-gray-50/50 dark:hover:bg-gray-900/50">
                                <td class="p-3 font-medium"><%= item.jumlah_kg %> Kg</td>
                                <td class="p-3"><%= item.jumlah_kue %> Pcs</td>
                                <td class="p-3">
                                    <span class="px-2 py-0.5 rounded text-[10px] font-bold <%= item.rasa === 'pedas' ? 'bg-red-50 text-red-600 dark:bg-red-950/30 dark:text-red-400' : 'bg-green-50 text-green-600 dark:bg-green-950/30 dark:text-green-400' %>">
                                        <%= item.rasa.toUpperCase() %>
                                    </span>
                                </td>
                                <td class="p-3 capitalize"><%= item.ukuran %></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p class="text-gray-400 dark:text-gray-500 text-xs italic py-2">Belum ada adonan rilis masak yang diinput khusus hari ini.</p>
        <% } %>
    </div>
</div>

<script>
    function tambahBarisProduksi() {
        const wrapper = document.getElementById('wrapper-produksi');
        const newRow = document.createElement('div');
        newRow.className = "produksi-row p-4 bg-amber-50/40 dark:bg-gray-900/40 rounded-xl border border-dashed border-amber-200 dark:border-gray-700 animate-fade-in";
        newRow.innerHTML = `
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                <div>
                    <input type="number" step="0.01" name="jumlah_kg" required class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border text-sm">
                </div>
                <div>
                    <input type="number" name="jumlah_kue" required class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border text-sm">
                </div>
                <div>
                    <select name="rasa" class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border text-sm">
                        <option value="tidak pedas">Tidak Pedas</option>
                        <option value="pedas">Pedas</option>
                    </select>
                </div>
                <div>
                    <select name="ukuran" class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border text-sm">
                        <option value="kecil">Kecil</option>
                        <option value="besar">Besar</option>
                        <option value="jumbo">Jumbo</option>
                    </select>
                </div>
            </div>
            <div class="text-right mt-2">
                <button type="button" onclick="hapusBarisProduksi(this)" class="text-xs text-red-500 font-semibold hover:underline btn-hapus-prod">Hapus Baris</button>
            </div>
        `;
        wrapper.appendChild(newRow);
        toggleHapusProdVisibility();
    }

    function hapusBarisProduksi(button) {
        button.closest('.produksi-row').remove();
        toggleHapusProdVisibility();
    }

    function toggleHapusProdVisibility() {
        const rows = document.querySelectorAll('.produksi-row');
        rows.forEach(row => {
            const btn = row.querySelector('.btn-hapus-prod');
            if (btn) {
                if (rows.length === 1) btn.classList.add('hidden');
                else btn.classList.remove('hidden');
            }
        });
    }
</script>
<%- include('layouts/footer') %>