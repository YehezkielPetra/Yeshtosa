<%- include('layouts/header') %>
<div class="max-w-6xl mx-auto space-y-8">
    
    <div class="bg-white dark:bg-gray-800 p-8 rounded-2xl shadow-sm border dark:border-gray-700">
        <div class="flex items-center space-x-2 mb-6">
            <span class="text-xl">🍳</span>
            <h3 class="text-xl font-bold font-serif text-gray-800 dark:text-white">Input Kebutuhan Produksi Masak</h3>
        </div>
        
        <form action="/produksi" method="POST" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-1">Tanggal Jadwal Masak</label>
                    <input type="date" name="tanggal_produksi" required class="w-full p-3 bg-gray-50 dark:bg-gray-700 rounded-xl border border-gray-200 dark:border-gray-600 font-medium text-gray-900 dark:text-white">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-600 dark:text-gray-300 mb-1">Masak Berapa? (Total Bahan Kg Adonan)</label>
                    <input type="number" step="0.01" name="jumlah_kg" required placeholder="Contoh: 20" class="w-full p-3 bg-gray-50 dark:bg-gray-700 rounded-xl border border-gray-200 dark:border-gray-600 font-medium text-gray-900 dark:text-white">
                </div>
            </div>

            <hr class="dark:border-gray-700">
            
            <div class="hidden md:grid grid-cols-12 gap-4 px-4 text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wider">
                <div class="col-span-4">Jumlah Gogos Jadi (Pcs)</div>
                <div class="col-span-4">Rasa Varian</div>
                <div class="col-span-3">Ukuran Kue</div>
                <div class="col-span-1 text-center">Aksi</div>
            </div>

            <div id="wrapper-produksi" class="space-y-3">
                <div class="produksi-row p-4 bg-amber-50/40 dark:bg-gray-900/40 rounded-xl border border-gray-100 dark:border-gray-700">
                    <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
                        <div class="col-span-1 md:col-span-4">
                            <input type="number" name="jumlah_kue" required placeholder="Contoh: 200" class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border dark:border-gray-600 text-sm text-gray-900 dark:text-white">
                        </div>
                        <div class="col-span-1 md:col-span-4">
                            <select name="rasa" class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border dark:border-gray-600 text-sm text-gray-900 dark:text-white">
                                <option value="tidak pedas">Tidak Pedas</option>
                                <option value="pedas">Pedas</option>
                            </select>
                        </div>
                        <div class="col-span-1 md:col-span-3">
                            <select name="ukuran" class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border dark:border-gray-600 text-sm text-gray-900 dark:text-white">
                                <option value="kecil">Kecil</option>
                                <option value="besar">Besar</option>
                                <option value="jumbo">Jumbo</option>
                            </select>
                        </div>
                        <div class="col-span-1 md:col-span-1 text-center">
                            <button type="button" onclick="hapusBarisProduksi(this)" class="text-xs text-red-500 font-semibold hover:underline hidden btn-hapus-prod">Hapus</button>
                        </div>
                    </div>
                </div>
            </div>

            <button type="button" onclick="tambahBarisProduksi()" class="w-full py-2.5 bg-gray-50 dark:bg-gray-700/50 hover:bg-gray-100 dark:hover:bg-gray-700 text-gray-700 dark:text-gray-200 text-xs font-bold rounded-xl transition border border-dashed border-gray-300 dark:border-gray-600">
                + Tambah Pembagian Varian Kue dari Adonan Ini
            </button>

            <button type="submit" class="w-full py-3 bg-amber-500 hover:bg-amber-600 text-white font-bold rounded-xl shadow-sm transition">Simpan Rencana Rilis Produksi</button>
        </form>
    </div>

    <div class="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-sm border dark:border-gray-700">
        <div class="flex items-center space-x-2 mb-4">
            <span>📋</span>
            <h4 class="text-base font-bold font-serif text-gray-800 dark:text-gray-200">Manajemen Pembaruan Produksi Hari Ini</h4>
        </div>
        
        <% if (produksiHariIni && produksiHariIni.length > 0) { %>
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm border-collapse">
                    <thead>
                        <tr class="bg-gray-50 dark:bg-gray-900 text-gray-700 dark:text-gray-300 font-semibold border-b dark:border-gray-700">
                            <th class="p-3">Porsi Masak</th>
                            <th class="p-3">Hasil Jadi (Pcs)</th>
                            <th class="p-3">Varian Rasa</th>
                            <th class="p-3">Ukuran</th>
                            <th class="p-3">Tanggal Jadwal</th>
                            <th class="p-3 text-center">Modifikasi Aksi</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-700 text-gray-700 dark:text-gray-300">
                        <% 
                           let lastKgKey = ""; 
                           produksiHariIni.forEach(item => { 
                              let currentKgKey = `${new Date(item.tanggal_produksi).toLocaleDateString('fr-CA')}_${parseFloat(item.jumlah_kg).toFixed(2)}`;
                        %>
                            <tr class="align-middle hover:bg-gray-50/50 dark:hover:bg-gray-900/50">
                                <td class="p-3">
                                    <% if (currentKgKey !== lastKgKey) { %>
                                        <input type="number" step="0.01" form="form-prod-<%= item.id %>" name="jumlah_kg" value="<%= item.jumlah_kg %>" class="w-20 p-1 text-center bg-gray-50 dark:bg-gray-700 rounded border dark:border-gray-600 font-semibold">
                                        <span class="text-xs font-bold text-gray-400">Kg</span>
                                    <% } else { %>
                                        <input type="hidden" form="form-prod-<%= item.id %>" name="jumlah_kg" value="<%= item.jumlah_kg %>">
                                        <span class="text-xs italic text-gray-400">(Sama Seperti Atas)</span>
                                    <% } %>
                                </td>
                                <td class="p-3">
                                    <input type="number" form="form-prod-<%= item.id %>" name="jumlah_kue" value="<%= item.jumlah_kue %>" class="w-20 p-1 text-center bg-gray-50 dark:bg-gray-700 rounded border dark:border-gray-600">
                                </td>
                                <td class="p-3">
                                    <select form="form-prod-<%= item.id %>" name="rasa" class="p-1 bg-gray-50 dark:bg-gray-700 rounded border dark:border-gray-600 text-xs">
                                        <option value="tidak pedas" <%= item.rasa==='tidak pedas'?'selected':'' %>>Tidak Pedas</option>
                                        <option value="pedas" <%= item.rasa==='pedas'?'selected':'' %>>Pedas</option>
                                    </select>
                                </td>
                                <td class="p-3">
                                    <select form="form-prod-<%= item.id %>" name="ukuran" class="p-1 bg-gray-50 dark:bg-gray-700 rounded border dark:border-gray-600 text-xs">
                                        <option value="kecil" <%= item.ukuran==='kecil'?'selected':'' %>>Kecil</option>
                                        <option value="besar" <%= item.ukuran==='besar'?'selected':'' %>>Besar</option>
                                        <option value="jumbo" <%= item.ukuran==='jumbo'?'selected':'' %>>Jumbo</option>
                                    </select>
                                </td>
                                <td class="p-3">
                                    <input type="date" form="form-prod-<%= item.id %>" name="tanggal_produksi" value="<%= item.tanggal_produksi.toISOString().split('T')[0] %>" class="p-1 bg-gray-50 dark:bg-gray-700 rounded border dark:border-gray-600 text-xs">
                                </td>
                                <td class="p-3 text-center space-x-1 whitespace-nowrap">
                                    <form id="form-prod-<%= item.id %>" action="/produksi/update/<%= item.id %>" method="POST" class="inline">
                                        <button type="submit" class="bg-amber-500 hover:bg-amber-600 text-white px-2.5 py-1.5 rounded-lg text-xs font-semibold shadow-sm">Simpan</button>
                                    </form>
                                    <a href="/produksi/delete/<%= item.id %>" onclick="return confirm('Hapus item adonan ini?')" class="inline-block bg-red-500 hover:bg-red-600 text-white px-2.5 py-1.5 rounded-lg text-xs font-semibold shadow-sm">Hapus</a>
                                </td>
                            </tr>
                        <% 
                           lastKgKey = currentKgKey;
                           }) 
                        %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <p class="text-gray-400 dark:text-gray-500 text-xs italic py-2">Belum ada adonan rilis masak yang diinput khusus hari ini.</p>
        <% } %>
    </div>
</div>

<script>
    function tambahBarisProduksi() {
        const wrapper = document.getElementById('wrapper-produksi');
        const newRow = document.createElement('div');
        newRow.className = "produksi-row p-4 bg-amber-50/40 dark:bg-gray-900/40 rounded-xl border border-gray-100 dark:border-gray-700 transition duration-150";
        newRow.innerHTML = `
            <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
                <div class="col-span-1 md:col-span-4">
                    <input type="number" name="jumlah_kue" required placeholder="Contoh: 150" class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border dark:border-gray-600 text-sm text-gray-900 dark:text-white">
                </div>
                <div class="col-span-1 md:col-span-4">
                    <select name="rasa" class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border dark:border-gray-600 text-sm text-gray-900 dark:text-white">
                        <option value="tidak pedas">Tidak Pedas</option>
                        <option value="pedas">Pedas</option>
                    </select>
                </div>
                <div class="col-span-1 md:col-span-3">
                    <select name="ukuran" class="w-full p-2.5 bg-white dark:bg-gray-700 rounded-lg border dark:border-gray-600 text-sm text-gray-900 dark:text-white">
                        <option value="kecil">Kecil</option>
                        <option value="besar">Besar</option>
                        <option value="jumbo">Jumbo</option>
                    </select>
                </div>
                <div class="col-span-1 md:col-span-1 text-center">
                    <button type="button" onclick="hapusBarisProduksi(this)" class="text-xs text-red-500 font-semibold hover:underline btn-hapus-prod">Hapus</button>
                </div>
            </div>
        `;
        wrapper.appendChild(newRow);
        toggleHapusProdVisibility();
    }
    function hapusBarisProduksi(button) { button.closest('.produksi-row').remove(); toggleHapusProdVisibility(); }
    function toggleHapusProdVisibility() {
        const rows = document.querySelectorAll('.produksi-row');
        rows.forEach(row => {
            const btn = row.querySelector('.btn-hapus-prod');
            if (btn) { if (rows.length === 1) btn.classList.add('hidden'); else btn.classList.remove('hidden'); }
        });
    }
</script>
<%- include('layouts/footer') %>