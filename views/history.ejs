<%- include('layouts/header') %>
<div class="bg-white dark:bg-gray-800 p-6 rounded-2xl shadow-sm border dark:border-gray-700 mb-6">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
        <h2 class="text-xl font-bold font-serif text-gray-800 dark:text-white">Riwayat Log Historis Toko Kue</h2>
        
        <form action="/history" method="GET" class="flex flex-wrap items-center gap-3">
            <div class="flex items-center space-x-2">
                <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Cari Nama:</label>
                <input type="text" name="nama" value="<%= cariNama %>" placeholder="Nama pelanggan..." class="p-2 bg-gray-50 dark:bg-gray-900 rounded-xl border dark:border-gray-700 text-sm focus:outline-none focus:ring-1 focus:ring-amber-500 text-gray-900 dark:text-white">
            </div>

            <div class="flex items-center space-x-2">
                <label class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">Hari:</label>
                <input type="date" name="tanggal" value="<%= filterTanggal %>" class="p-2 bg-gray-50 dark:bg-gray-900 rounded-xl border dark:border-gray-700 text-sm text-gray-900 dark:text-white">
            </div>

            <button type="submit" class="bg-amber-500 hover:bg-amber-600 text-white px-5 py-2 rounded-xl text-sm font-medium transition shadow-sm">Saring Log</button>
            
            <% if(filterTanggal || cariNama) { %>
                <a href="/history" class="bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-200 px-4 py-2 rounded-xl text-sm transition">Reset</a>
            <% } %>
        </form>
    </div>
</div>

<div class="flex space-x-2 mb-6 bg-gray-100 dark:bg-gray-900 p-1.5 rounded-2xl w-fit">
    <button type="button" onclick="switchTab('pesanan')" id="tab-btn-pesanan" class="px-5 py-2.5 rounded-xl text-sm font-bold transition duration-200 bg-white dark:bg-gray-800 text-gray-800 dark:text-white shadow-sm">
        📦 Log Pesanan
    </button>
    <button type="button" onclick="switchTab('produksi')" id="tab-btn-produksi" class="px-5 py-2.5 rounded-xl text-sm font-bold transition duration-200 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200">
        🍳 Produksi Dapur
    </button>
</div>

<div>
    
    <div id="content-tab-pesanan" class="bg-white dark:bg-gray-800 rounded-2xl shadow-sm border dark:border-gray-700 p-5">
        <div class="flex items-center space-x-2 mb-4 border-b dark:border-gray-700 pb-2">
            <span>📦</span>
            <h3 class="font-serif font-bold text-base text-gray-800 dark:text-gray-200">Log Transaksi Pesanan</h3>
        </div>
        <div class="space-y-3">
            <% if(orders.length === 0) { %>
                <p class="text-center text-gray-400 py-6 text-sm italic">Tidak ada rekaman transaksi pesanan pada kriteria tersebut.</p>
            <% } %>
            <% orders.forEach(order => { %>
                <div class="p-4 border dark:border-gray-700 rounded-xl flex flex-col justify-between gap-2 bg-gray-50/30 dark:bg-gray-900/20">
                    <div>
                        <h4 class="font-bold text-sm text-gray-800 dark:text-white capitalize"><%= order.nama_pemesan %></h4>
                        
                        <div class="mt-2 space-y-1.5 pl-2 border-l-2 border-amber-300 dark:border-gray-600">
                            <% if (order.details && order.details.length > 0) { %>
                                <% order.details.forEach(detail => { %>
                                    <p class="text-xs text-gray-600 dark:text-gray-400">
                                        • <%= detail.jumlah_kue %> Pcs / Rasa <%= detail.rasa %> / Ukuran <%= detail.ukuran %> <%= detail.is_frozen ? '(Kondisi Frozen)':'' %>
                                    </p>
                                <% }) %>
                            <% } %>
                        </div>

                        <% if (order.catatan) { %>
                            <div class="mt-3 p-2.5 bg-gray-100/70 dark:bg-gray-700/50 rounded-xl text-xs text-gray-600 dark:text-gray-300 border border-gray-100 dark:border-gray-700">
                                <span class="font-bold text-[10px] text-amber-600 dark:text-amber-400 block uppercase tracking-wider mb-0.5">Catatan Pesanan:</span>
                                <%= order.catatan %>
                            </div>
                        <% } %>
                    </div>
                    
                    <div class="flex items-center justify-between mt-2 pt-2 border-t border-gray-100 dark:border-gray-700/50">
                        <span class="block text-[11px] font-medium text-gray-400">Kirim: <%= order.tanggal_kirim.toLocaleDateString('id-ID', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                        <span class="inline-block text-[10px] font-bold px-2 py-0.5 rounded-full <%= order.status_bayar==='sudah bayar'?'bg-green-100 text-green-700 dark:bg-green-900/20':'bg-red-100 text-red-700 dark:bg-red-900/20' %>">
                            <%= order.status_bayar.toUpperCase() %>
                        </span>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

    <div id="content-tab-produksi" class="hidden bg-white dark:bg-gray-800 rounded-2xl shadow-sm border dark:border-gray-700 p-5">
        <div class="flex items-center space-x-2 mb-4 border-b dark:border-gray-700 pb-2">
            <span>🍳</span>
            <h3 class="font-serif font-bold text-base text-gray-800 dark:text-gray-200">Log Aktivitas Produksi Dapur</h3>
        </div>
        <div class="space-y-3">
            <% if(productions.length === 0) { %>
                <p class="text-center text-gray-400 py-6 text-sm italic">Tidak ada rekaman aktivitas masak pada tanggal tersebut.</p>
            <% } %>
            <% productions.forEach(prod => { %>
                <div class="p-4 border dark:border-gray-700 rounded-xl flex flex-col justify-between gap-2 bg-amber-50/10 dark:bg-amber-950/5">
                    <div>
                        <h4 class="font-bold text-sm text-gray-800 dark:text-gray-200">Total Adonan Masak: <%= parseFloat(prod.jumlah_kg).toFixed(2) %> Kg</h4>
                        
                        <div class="mt-2 space-y-1.5 pl-2 border-l-2 border-emerald-400 dark:border-gray-600">
                            <% prod.details.forEach(detail => { %>
                                <p class="text-xs text-gray-600 dark:text-gray-400">
                                    • Hasil: <%= detail.jumlah_kue %> Pcs / Ukuran <%= detail.ukuran.toUpperCase() %> / Varian Rasa 
                                    <span class="px-1 rounded text-[10px] font-bold <%= detail.rasa === 'pedas' ? 'text-red-600 bg-red-50 dark:bg-red-950/20' : 'text-green-600 bg-green-50 dark:bg-green-950/20' %>">
                                        <%= detail.rasa.toUpperCase() %>
                                    </span>
                                </p>
                            <% }) %>
                        </div>
                    </div>
                    <div class="mt-2 pt-2 border-t border-gray-100 dark:border-gray-700/50">
                        <span class="block text-[11px] font-medium text-gray-400 text-right">Tanggal Jadwal Rilis: <%= new Date(prod.tanggal_produksi).toLocaleDateString('id-ID', { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' }) %></span>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>

</div>

<script>
    function switchTab(tabName) {
        const pesananBtn = document.getElementById('tab-btn-pesanan');
        constBox = document.getElementById('tab-btn-produksi');
        const pesananContent = document.getElementById('content-tab-pesanan');
        const produksiContent = document.getElementById('content-tab-produksi');

        if (tabName === 'pesanan') {
            pesananContent.classList.remove('hidden');
            constBox.classList.add('hidden');
            pesananBtn.className = "px-5 py-2.5 rounded-xl text-sm font-bold transition duration-200 bg-white dark:bg-gray-800 text-gray-800 dark:text-white shadow-sm";
            constBox.className = "px-5 py-2.5 rounded-xl text-sm font-bold transition duration-200 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200";
        } else if (tabName === 'produksi') {
            constBox.classList.remove('hidden');
            pesananContent.classList.add('hidden');
            constBox.className = "px-5 py-2.5 rounded-xl text-sm font-bold transition duration-200 bg-white dark:bg-gray-800 text-gray-800 dark:text-white shadow-sm";
            pesananBtn.className = "px-5 py-2.5 rounded-xl text-sm font-bold transition duration-200 text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200";
        }
    }
</script>
<%- include('layouts/footer') %>